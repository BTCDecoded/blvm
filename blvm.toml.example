# BLVM Node Configuration Example
# Copy this file to blvm.toml and customize as needed
# Usage: blvm --config blvm.toml

# Network listening address
listen_addr = "0.0.0.0:8333"

# Transport: TOML serde uses tcponly | irohonly | quinnonly | hybrid | all (CLI/ENV use tcp_lowercase)
transport_preference = "tcponly"

# Maximum number of peers
max_peers = 100

# Protocol version: mainnet, testnet, testnet4, signet, or regtest.
# BitcoinV1 and Testnet3 are accepted aliases. The binary writes the names above.
protocol_version = "regtest"

# Enable self-advertisement (send own address to peers)
enable_self_advertisement = true

# Persistent peers (peers to connect to on startup)
# persistent_peers = ["1.2.3.4:8333", "5.6.7.8:8333"]

# A [payment] table in this file is ignored. blvm-payment reads config.toml in its own data directory.
# [stratum_v2] only switches P2P TLV demux. Miner TCP is the blvm-stratum-v2 module file.
# [stratum_v2]
# p2p_stratum_demux = true

# RPC authentication configuration
# [rpc_auth]
# required = false
# tokens = []
# certificates = []
# rate_limit_burst = 100
# rate_limit_rate = 10

# Ban list sharing configuration
# [ban_list_sharing]
# enabled = true
# share_mode = "periodic"
# periodic_interval_seconds = 300
# min_ban_duration_to_share = 3600

# Storage and pruning configuration
# [storage]
# database_backend = "auto"  # default release build: usually RocksDB; or force "redb", "sled", etc.
# 
# [storage.pruning]
# mode = { type = "normal", keep_from_height = 0, min_recent_blocks = 288 }
# auto_prune = true
# min_blocks_to_keep = 144

# Module system configuration
[modules]
enabled = true
modules_dir = "modules"
data_dir = "data/modules"
socket_dir = "data/modules/sockets"
# Discovery index for bootstrap-download of modules listed below but missing on disk.
registry_url = "https://raw.githubusercontent.com/BTCDecoded/blvm/main/registry/modules.json"
# The three pins below are the baseline even when this table only sets a path.
# An inline name adds or replaces one pin. enabled_modules = [] replaces the
# baseline and loads only binaries already on disk.
blvm-miniscript = "0.1.*"
blvm-index = "0.1.*"
# blvm-fees and blvm-upstream are not pinned. External fee data stays off until
# the operator sets [fees] estimator and [module_network.blvm-upstream] http_allow.
# Electrum and Esplora bind here. An unset listen does not bind.
# [services.esplora]
# module = "blvm-index"
# listen = "127.0.0.1:3000"
# [services.electrum]
# module = "blvm-index"
# listen = "127.0.0.1:50001"
# Per-module spawn overrides; `version` pins bootstrap when inline `name = "…"` would conflict:
[modules.blvm-zmq]
version = "0.1.*"
hashblock = "tcp://127.0.0.1:28332"
hashtx = "tcp://127.0.0.1:28333"
rawblock = "tcp://127.0.0.1:28334"
rawtx = "tcp://127.0.0.1:28335"
sequence = "tcp://127.0.0.1:28336"
# Legacy array form still supported: enabled_modules = ["blvm-miniscript"]  # unpinned (*)
# Opt-out: never auto-load or bootstrap-download these names (manifest `name`), even if on disk.
# disabled_modules = ["some-module"]

# Fee estimator. Omit the table to use the built-in defaults (estimator on).
# health_required is false on regtest and true elsewhere when the key is omitted.
# Bucket spacing, decays, and success thresholds are not configurable.
# history_enabled and mempool_enabled cannot both be false.
# [fees]
# enabled = true
# history_enabled = true
# mempool_enabled = true
# allow_mempool_only = true
# mempool_horizon_blocks = 1
# mempool_percentile_conservative = 50
# mempool_percentile_economical = 75
# projection_full_threshold = 0.95
# health_window_blocks = 6
# health_min_ratio = 0.75
# recompute_interval_secs = 7
# multiplier = 1.0
# state_path = "data/fee_estimator.dat"
# persist_interval_blocks = 6
# max_state_age_blocks = 6048
# eval_log_path = "data/fee-eval.jsonl"
# lnd_targets = [1, 2, 3, 6, 12, 24, 48, 144, 504, 1008]

# Per-module configuration overrides (passed to each module via env on spawn)
[modules.blvm-marketplace]
# modules_dir is inherited from [modules].modules_dir above
# (Legacy: you could set registry_url here instead of under [modules].)
