# Mainnet IBD example — use via ./scripts/start-ibd-mainnet.sh or:
#   blvm --config blvm-mainnet-ibd.toml.example --network mainnet --data-dir ~/.local/share/blvm-mainnet
# IBD: parallel mode; auto-prefers LAN Core; optional BLVM_IBD_PEERS / BLVM_IBD_MODE
#
# ── Hardware ───────────────────────────────────────────────────────────────────
#   Disk (heed3/LMDB): the map is 70% of free space, clamped 48 GiB–4 TiB, then
#   data.mdb+128 GiB when resuming. Omit [storage.heed3] map_size_mb unless you
#   must pin a ceiling.
#
#   RAM: MemoryGuard sizes the UTXO cache and download-ahead. workload = "auto"
#   below classifies the envelope from free RAM. It does not grant a 16 GiB cache.
#   Figures are the tier clamp. The envelope (45% of the RSS budget) can still
#   shrink the cache. Under 12 GB RAM, or under 6144 MiB free, the cache is also
#   at most 7% of RAM, and that cap is between 128 and 384 MiB.
#     under 4 GB:                 cache 64–128 MiB,    ahead 64
#     4–7 GB:                     cache 128–256 MiB,   ahead 128
#     8–11 GB:                    cache 256–512 MiB,   then the 7% cap; ahead 256
#     12–15 GB:                   cache 768–1536 MiB,  ahead 256
#     ~16 GB through 18 GiB:      cache 1024–1400 MiB, ahead 320
#     above ~18 GB and under 32:  cache 2048–4096 MiB, ahead 512
#     ≥ 32 GB, shared envelope:   cache up to 4096 MiB
#     ≥ 32 GB, dedicated envelope: cache up to 16384 MiB
#     ahead at ≥ 32 GB is 1024, or 2048 at ≥ 64 GB
#
# ── Peers ─────────────────────────────────────────────────────────────────────
#   Outbound target defaults to 8. The peer cap (max_peers) defaults to 100.
#   That target is not the IBD download roster.
# ──────────────────────────────────────────────────────────────────────────────

transport_preference = "tcponly"
# If bind fails: Core may be on :8333 — stop it or change port
listen_addr = "0.0.0.0:8333"
protocol_version = "BitcoinV1"

[storage]
data_dir = "~/.local/share/blvm-mainnet"
database_backend = "heed3"

[storage.heed3]
# map_size_mb: optional LMDB mmap ceiling override (MiB). When omitted, blvm auto-tunes
# from free disk (70%, clamped 48 GiB–4 TiB) and bumps to data.mdb+128 GiB on resume.
# Soak/testing should leave this unset. Pin only for operator policy, e.g.:
# map_size_mb = 2097152

[storage.pruning]
# Every 144 blocks, drop bodies behind keep_blocks. The block-accepted path
# does this during sync. incremental_prune_during_ibd skips writing bodies
# outside keep_blocks for normal and aggressive. Deleting them during IBD
# still requires aggressive.
# mode is disabled (keep every body), normal, or aggressive. aggressive also
# writes UTXO commitments. Omitted keep_blocks is 288.
auto_prune = true
mode = "normal"
keep_blocks = 144

[ibd]
# Download chunk, and how many blocks one peer may have in flight.
chunk_size = 64
max_blocks_in_transit_per_peer = 128
download_timeout_secs = 45
mode = "parallel"
# auto | shared | dedicated. auto uses free RAM after headers.
# shared keeps the smaller envelope. dedicated asks for the larger one and is refused below 70% free.
# BLVM_IBD_EXCLUSIVE=1 forces the larger envelope.
workload = "auto"

[rpc]
max_request_size_bytes = 1048576

[logging]
level = "info"

# Baseline modules. blvm-miniscript serves getdescriptorinfo and analyzepsbt.
[modules]
enabled = true
blvm-miniscript = "0.1.*"
blvm-zmq = "0.1.*"
blvm-index = "0.1.*"
